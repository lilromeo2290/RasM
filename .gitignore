# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real env files are ignored below; .env.example is tracked)

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# RAS MUTA Foundation project-specific
# Local SQLite database (contains user submissions — do not commit)
/db/*.db
/db/*.db-journal
# User-uploaded files (temporary, processed into /public)
/upload/
# Generated screenshots / download artefacts / deployment bundles (large, not source)
/download/
/deploy-bundle/
# Keep the .env.example template tracked (force-added), but ignore real .env files
/.env
/.env.local
/.env.production
/.env.development
# Worklog personal notes (if any) — keep the shared worklog.md tracked though