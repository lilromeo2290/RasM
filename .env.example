# Database (SQLite file path — must be writable by the web server)
# Use an ABSOLUTE path on the VPS.
# Replace YOUR_USERNAME with your actual Webuzo/cPanel username.
# Domain: rasmutafoundation.org  |  Addon folder: rasmuta
DATABASE_URL=file:/home/YOUR_USERNAME/public_html/rasmuta/db/custom.db

# Node environment
NODE_ENV=production

# Port the Next.js standalone server listens on.
# Webuzo's "Node.js App" feature may set PORT via Passenger automatically;
# if running manually behind a reverse proxy, set this explicitly.
PORT=3000
